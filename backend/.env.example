# Port configuration
PORT=5000

# Firebase Configuration
# You can get your Project ID from the Firebase Console (Project Settings -> General)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Realtime Database URL
# Example: https://your-database-name-default-rtdb.firebaseio.com/
FIREBASE_DATABASE_URL=https://your-firebase-project-id-default-rtdb.firebaseio.com/

# Path to Firebase Service Account JSON credentials file
# Download this from Firebase Console (Project Settings -> Service Accounts -> Generate new private key)
# Place the downloaded file in the backend folder and rename it or reference it here
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./serviceAccountKey.json
